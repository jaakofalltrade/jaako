# Spotify credentials for the now_playing panel.
# Copy to .env.local and fill in — see docs/spotify-setup.md.
# Without these the panel renders its "offline" state; nothing else breaks.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# The write credential, for /lab/suggest only. TWO TOKENS ON PURPOSE.
#
# Spotify's scopes are verbs rather than resources, so no token can be limited to one
# playlist. The intent is that only the route which adds a track holds this one.
#
# BUT THE READ TOKEN IS NOT ACTUALLY READ-ONLY, which is worth knowing before relying
# on it. Spotify grants scopes per application rather than per token, so approving
# playlist-modify-public widened the token above too. "pnpm token:check" reports it.
# Real separation needs a second Spotify app; see docs/spotify-setup.md.
#
# playlist-modify-PRIVATE is never requested by either, so neither can reach a private
# playlist.
#
# Mint it with: node scripts/spotify-token.mjs <id> <secret> write
# Without it the suggestion page works and adding refuses. Nothing else notices.

SPOTIFY_WRITE_REFRESH_TOKEN=

# Resend API key for the contact form — see docs/contact-setup.md.
# The sender and recipient addresses are not secret and do not vary by deployment,
# so they live in src/constants/contact.ts, not here.
# Without this /api/contact answers 503 and the form tells the visitor to use the
# e-mail link instead.

RESEND_API_KEY=

# Which deployment this is: LOCAL, STAGING or PRODUCTION.
# Read once in src/server/serverConfig.ts. Anything unset falls back to LOCAL.
#
# THIS ONE DECIDES WHICH PLAYLIST GETS WRITTEN TO, so it is no longer cosmetic. LOCAL
# and STAGING write to the sandbox playlist; only PRODUCTION writes to the live one.
# An unset ENV on the production host means real visitor adds land on the sandbox,
# quietly and with nothing in the logs. Set it on the host, and set SPOTIFY_PLAYLIST_ID
# below as well so a missing ENV cannot pick the wrong playlist.
ENV=LOCAL

# The public playlist /lab/suggest writes to — see docs/suggest-setup.md.
#
# OPTIONAL. Both defaults are real playlists in src/constants/suggest.ts, chosen by
# deployment: SUGGEST_PLAYLIST_ID_DEVELOPMENT for LOCAL and STAGING,
# SUGGEST_PLAYLIST_ID_PRODUCTION for PRODUCTION. A fresh clone therefore renders a live
# playlist with no setup, and `pnpm dev` cannot add to the production one.
#
# Set this to override whichever the tier picked: to give staging a third playlist of
# its own, or on the production host as a belt-and-braces against ENV being unset there.
# The id is the segment after /playlist/ in the share URL — the "?si=..." on a copied
# link is a share token and is NOT part of the id.

SPOTIFY_PLAYLIST_ID=

# Neon Postgres, shared by the lab apps — see docs/neon-setup.md.
# The POOLED connection string, the one with -pooler in the host.
# Without it the suggestion list still renders, just without names, and adds refuse.

DATABASE_URL=
