# Spotify credentials for the now_playing panel.
# Copy to .env.local and fill in — see docs/spotify-setup.md.
# Without these the panel renders its "offline" state; nothing else breaks.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Resend credentials for the contact form — see docs/contact-setup.md.
# Without these /api/contact answers 503 and the form tells the visitor to use
# the e-mail link instead.

RESEND_API_KEY=
# Must be an address on a domain verified in Resend. A display name is optional.
CONTACT_FROM_EMAIL="jaako.xyz <contact@jaako.xyz>"
# Where submissions land.
CONTACT_TO_EMAIL=
