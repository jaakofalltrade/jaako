# Spotify credentials for the now_playing panel.
# Copy to .env.local and fill in — see docs/spotify-setup.md.
# Without these the panel renders its "offline" state; nothing else breaks.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Resend API key for the contact form — see docs/contact-setup.md.
# The sender and recipient addresses are not secret and do not vary by deployment,
# so they live in src/constants/contact.ts, not here.
# Without this /api/contact answers 503 and the form tells the visitor to use the
# e-mail link instead.

RESEND_API_KEY=

# Which deployment this is: LOCAL, STAGING or PRODUCTION.
# Read once in src/config/serverConfig.ts. Anything unset falls back to LOCAL.
ENV=LOCAL
