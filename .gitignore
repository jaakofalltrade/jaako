# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
#
# .env holds the non-secret defaults every deployment shares and IS committed.
# .env.local holds this machine's secrets and is not. Next resolves process.env first,
# then .env.local, then .env, so the host overrides both without either being edited.
.env*
!.env.example
!.env

# the local database
#
# PGlite writes a whole Postgres data directory here when DATABASE_URL is unset, which is
# every clone of this repo until somebody deliberately points one at Neon. It is
# disposable by design: delete it and `pnpm db:migrate` builds it again from the
# migrations, which is also how you throw away a week of test suggestions.
.pgdata/

# Which process currently has that directory open. PGlite will not enforce this itself -
# two processes in one data directory silently lose one side's writes - so the pid lives
# beside the directory and whoever finds it live refuses. Machine-local by definition.
.pgdata.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
/.claude/
